# Filter and sort a customer collection with stable pagination links
GET /v1/customers?status=active&sort=-created_at&page[size]=2 HTTP/1.1
Host: api.example.test
Accept: application/json

HTTP/1.1 200 OK
Content-Type: application/json

{
  "meta": {
    "page_size": 2,
    "total_count": 42,
    "sort": "-created_at",
    "filters": {
      "status": "active"
    }
  },
  "links": {
    "next": "/v1/customers?status=active&sort=-created_at&page[size]=2&page[after]=cus_202"
  }
}
