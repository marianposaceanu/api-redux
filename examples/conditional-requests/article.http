# Read the current representation and capture its ETag
GET /v1/articles/art_123 HTTP/1.1
Host: api.example.test
Accept: application/json

HTTP/1.1 200 OK
ETag: "article-v3"
Content-Type: application/json

# Update succeeds only when the precondition matches
PATCH /v1/articles/art_123 HTTP/1.1
Host: api.example.test
Content-Type: application/json
If-Match: "article-v3"

{
  "title": "Fresh Title"
}

HTTP/1.1 200 OK
ETag: "article-v4"

# A stale precondition fails with 412
PATCH /v1/articles/art_123 HTTP/1.1
Host: api.example.test
Content-Type: application/json
If-Match: "article-v2"

{
  "title": "Stale Update"
}

HTTP/1.1 412 Precondition Failed
ETag: "article-v3"
