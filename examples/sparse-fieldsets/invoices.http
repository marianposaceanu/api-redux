# Full invoice representation
GET /v1/invoices/inv_123 HTTP/1.1
Host: api.example.test
Accept: application/json

HTTP/1.1 200 OK
Content-Type: application/json

# Ask only for the fields the client needs
GET /v1/invoices/inv_123?fields[invoices]=status,total_cents HTTP/1.1
Host: api.example.test
Accept: application/json

HTTP/1.1 200 OK
Content-Type: application/json
